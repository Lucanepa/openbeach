{
  "appId": "com.openvolley.beach",
  "appName": "OpenBeach",
  "webDir": "dist-capacitor",
  "backgroundColor": "#ffffff",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "style": "LIGHT",
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    }
  }
}
