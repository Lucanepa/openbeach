{
  "name": "escoresheet",
  "version": "2.0.0",
  "description": "OpenBeach eScoresheet - Offline-first beach volleyball scoresheet application",
  "author": "OpenBeach",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "set VITE_HTTPS=true && vite",
    "dev:tunnel": "concurrently \"npm run dev\" \"npm run ngrok\"",
    "ngrok": "ngrok http 6173",
    "build": "vite build",
    "build:subdomains": "node scripts/build-subdomains.js",
    "build:android": "CAPACITOR=true vite build --emptyOutDir",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "android:icons": "python3 scripts/make-android-icons.py",
    "release:android": "scripts/release-android.sh",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/screen-orientation": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^4.2.0",
    "flag-icons": "^7.5.0",
    "html5-qrcode": "^2.3.8",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^25.7.4",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.52.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.530",
    "qrcode.react": "^4.2.0",
    "rasterizehtml": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.3",
    "read-excel-file": "^7.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.3.4",
    "jsdom": "^28.1.0",
    "ngrok": "^5.0.0-beta.2",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "glob": ">=11.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.openbeach.escoresheet",
    "productName": "OpenBeach eScoresheet",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "OpenBeach-eScoresheet-Setup.${ext}",
      "publisherName": "OpenBeach"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.sports",
      "artifactName": "OpenBeach-eScoresheet.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Sports"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
