<?xml version="1.0" encoding="utf-8"?>
<!--
  Venue mode: with no internet the tablets talk to a LOCAL relay (the OpenBeach
  desktop app at http://<LAN-IP>:5174 / ws://<LAN-IP>:8081, the OpenVolley
  desktop app on 5173 / 8080, the venue server or the Pi) over plain HTTP
  (owner decision). LAN IPs cannot be listed in a domain-config, so cleartext
  is allowed app-wide; the cloud backend is always https. Which hosts the app
  may talk to at all is enforced in src_beach/utils_beach/backendConfig_beach.js
  (isAllowedBackendUrl: localhost, RFC 1918 ranges, *.local, *.openvolley.app).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
