# Claude Code local settings (per machine, never shared)
.claude/settings.local.json
.claude/plans/

# Match data (audit SEC-27, OpenVolley's B6 block): the files the app and
# tools write hold players' and officials' names, licence numbers and
# signatures, i.e. personal data, which must never land in this public repo,
# wherever the file was saved. Test data (fictional people only) goes into a
# fixtures folder. Checked by .githooks/test-gitignore.sh; .gitleaks.toml
# (match-data-*) also catches them when added anyway.
# App backups (backupManager_beach, logger_beach, Scoreboard_beach downloads)
backup_g*_set*.json
backup_set*_*.json
# Native auto-backups: one folder per match (game<N>-…, match-…, test-…, see
# nativeBackup/rotation_beach.js) with <yyyymmdd>T<hhmmss>.<ms>Z-<seq>.json
# event files and latest.json
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9].[0-9][0-9][0-9]Z-*.json
**/game[0-9]*/latest.json
**/match-*/latest.json
**/test-game[0-9]*/latest.json
**/test-match-*/latest.json
# Logs, diagnostics and activity exports; browser network exports (HAR) of
# the API traffic
debug_logs/
debug_logs_*.json
logs_*.txt
comprehensive_logs*.json
comprehensive_logs*.ndjson
diagnostic_log*.json
*.ndjson
*.jsonl
openbeach-diagnostics*.txt
openbeach-diagnostics*.jsonl
openbeach-activity*.json
openbeach-activity*.ndjson
openbeach-activity*.csv
openvolley-diagnostics*.txt
openvolley-diagnostics*.jsonl
openvolley-activity*.json
openvolley-activity*.ndjson
openvolley-activity*.csv
*.har
# Match exports
MatchData_*.json
Match_*_vs_*.zip
match-data-*.json
match_stopped_*.json
database_export_*.json
# Roster, licence, participant and ranking lists (scoresheet PDFs: *.pdf above)
*.xlsx
*.xls
*.ods
*.csv
*.tsv
# Test fixtures stay trackable: tests/fixtures, __tests__/fixtures and
# __fixtures__ only (any other folder named like "fixtures" is not a test
# tree). Negated by extension, so the key and .env rules above still apply.
!**/tests/fixtures/**/*.json
!**/tests/fixtures/**/*.jsonl
!**/tests/fixtures/**/*.ndjson
!**/tests/fixtures/**/*.har
!**/tests/fixtures/**/*.txt
!**/tests/fixtures/**/*.zip
!**/tests/fixtures/**/*.xlsx
!**/tests/fixtures/**/*.xls
!**/tests/fixtures/**/*.ods
!**/tests/fixtures/**/*.csv
!**/tests/fixtures/**/*.tsv
!**/tests/fixtures/**/*.pdf
!**/__tests__/fixtures/**/*.json
!**/__tests__/fixtures/**/*.jsonl
!**/__tests__/fixtures/**/*.ndjson
!**/__tests__/fixtures/**/*.har
!**/__tests__/fixtures/**/*.txt
!**/__tests__/fixtures/**/*.zip
!**/__tests__/fixtures/**/*.xlsx
!**/__tests__/fixtures/**/*.xls
!**/__tests__/fixtures/**/*.ods
!**/__tests__/fixtures/**/*.csv
!**/__tests__/fixtures/**/*.tsv
!**/__tests__/fixtures/**/*.pdf
